# Copy to .env and fill in.
# The simple product needs NO LLM keys — it just streams camera frames.

# Frame source: "webcam" (works today) or "mentra" (glasses, stub — see HANDOFF)
FRAME_SOURCE=webcam
WEBCAM_INDEX=0

# Mentra (only if FRAME_SOURCE=mentra — get these from console.mentra.glass)
MENTRA_API_KEY=
MENTRA_PACKAGE=com.vicarious.glasses

# Session config
SESSION_SECONDS=60
FRAME_INTERVAL_SECONDS=2
